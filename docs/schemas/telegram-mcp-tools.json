    {
      "name": "send_message",
      "description": "Send literal plain text as the owner. Requires explicit user intent and an unambiguous recipient.\n\n        request_id: fresh UUID for each intended send; SAME UUID+arguments on retry returns stored receipt.\n        Max 4096 UTF-16 units; no auto-splitting, Markdown parsing or link previews. reply_to is optional.\n        Only status=sent confirms success. Pending/unknown requires history reconciliation, NOT a new key.\n        ",
      "inputSchema": {
        "properties": {
          "peer": {
            "title": "Peer",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
