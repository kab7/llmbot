# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+79991234567

# ChatGPT Plus/Pro subscription through official Sign in with ChatGPT OAuth.
# Generate the protected file locally with:
#   venv/bin/python scripts/chatgpt_auth.py
# Never paste its access_token or refresh_token into .env, Telegram, or chat.
CHATGPT_CREDENTIALS_FILE=chatgpt_credentials.json
# "auto" uses the first visible model returned for the signed-in account.
# Use /models and /setmodel <slug> to pin an exact available model.
CHATGPT_MODEL=auto

# HTTP поведение LLM запросов
# Таймаут одного HTTP-запроса к модели (секунды)
LLM_REQUEST_TIMEOUT_SECONDS=20
# Таймаут большого объединённого запроса по папке; не может быть меньше общего
COMBINED_LLM_REQUEST_TIMEOUT_SECONDS=90
# Количество раундов retry по списку моделей
LLM_MAX_RETRIES=3

# Логи
# Основной лог бота (с ротацией)
LOG_FILE_PATH=bot.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
# Отдельный лог LLM запросов/ответов (с ротацией)
LLM_TRAFFIC_LOG_PATH=llm_traffic.log
LLM_TRAFFIC_LOG_MAX_BYTES=20971520
LLM_TRAFFIC_LOG_BACKUP_COUNT=5

# Пути к локальным данным
# Для Docker обычно используют /data (через volume)
SESSION_NAME=telethon_session
SCHEDULES_FILE=schedules.db

# Optional Telegram MCP: empty socket disables it outside Docker.
# Docker uses an owner-only socket inside the container; access is through SSH.
TELEGRAM_MCP_SOCKET=
# Durable send receipts; sensitive runtime state, never commit it.
TELEGRAM_MCP_STATE_FILE=telegram_mcp.db

# Admin access
ADMIN_USER_ID=your_telegram_user_id_here
